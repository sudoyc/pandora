{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pandora.local/schemas/download-event.schema.json",
  "title": "Pandora Download Event",
  "type": "object",
  "required": ["event", "gid"],
  "additionalProperties": true,
  "properties": {
    "event": {
      "type": "string",
      "enum": [
        "download_submitted",
        "download_already_queued",
        "download_queued",
        "download_progress",
        "download_complete",
        "download_complete_with_errors",
        "download_error",
        "download_cancelled",
        "download_paused",
        "download_auth_failed"
      ]
    },
    "gid": {"type": "string"},
    "title": {"type": "string"},
    "status": {"type": "string"},
    "detail": {"type": "string"},
    "phase": {"type": "string", "enum": ["cover", "thumbs", "pages"]},
    "page": {"type": "integer"},
    "total": {"type": "integer"},
    "failed_pages": {"type": "array", "items": {"type": "integer"}},
    "error": {"type": "string"},
    "reason": {"type": "string"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"event": {"const": "download_complete"}},
        "required": ["event"]
      },
      "then": {
        "not": {"required": ["path"]}
      }
    }
  ],
  "not": {"required": ["type"]}
}
